generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Institution {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  address     String?
  city        String?
  state       String?
  country     String?  @default("India")
  website     String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  departments   Department[]
  academicYears AcademicYear[]
  programs      Program[]
  notices       Notice[]
  events        Event[]
  auditLogs     AuditLog[]
}

model Department {
  id            String      @id @default(uuid())
  institutionId String
  name          String
  code          String
  headFacultyId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programs      Program[]
  faculty       Faculty[]
  students      Student[]
  courses       Course[]

  @@unique([institutionId, code])
}

model Program {
  id            String      @id @default(uuid())
  institutionId String
  departmentId  String
  name          String
  code          String
  durationYears Int         @default(4)
  totalSemesters Int        @default(8)
  degree        String      @default("B.Tech")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department    Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  students      Student[]
  semesters     Semester[]
  courses       Course[]

  @@unique([institutionId, code])
}

model AcademicYear {
  id            String      @id @default(uuid())
  institutionId String
  year          String      // e.g. "2025-2026"
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  semesters     Semester[]
  students      Student[]
  enrollments   Enrollment[]
  exams         Exam[]

  @@unique([institutionId, year])
}

model Semester {
  id            String       @id @default(uuid())
  programId     String
  academicYearId String
  number        Int          // 1 to 8
  term          String       // "FALL", "SPRING", "ODD", "EVEN"
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  program       Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  courses       Course[]
  enrollments   Enrollment[]
  students      Student[]
  exams         Exam[]

  @@unique([programId, academicYearId, number])
}

model User {
  id            String        @id @default(uuid())
  institutionId String?
  email         String        @unique
  password      String
  role          String        // "SUPER_ADMIN", "ADMIN", "DEPT_HEAD", "FACULTY", "PLACEMENT_OFFICER", "STUDENT"
  firstName     String
  lastName      String
  phone         String?
  avatarUrl     String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  institution   Institution?  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student       Student?
  faculty       Faculty?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  noticesAuthored Notice[]
  noticeReads   NoticeRead[]
  notifications Notification[]
  requests      Request[]
  eventRegistrations EventRegistration[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Student {
  id            String       @id @default(uuid())
  userId        String       @unique
  departmentId  String
  programId     String
  academicYearId String
  currentSemesterId String?
  rollNumber    String       @unique
  admissionNumber String?    @unique
  batch         String       // e.g. "2023-2027"
  currentSemester Int        @default(1)
  cgpa          Float        @default(0.0)
  activeBacklogs Int         @default(0)
  guardianName  String?
  guardianPhone String?
  dateOfBirth   DateTime?
  gender        String?
  address       String?
  bloodGroup    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  program       Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  semester      Semester?    @relation(fields: [currentSemesterId], references: [id])
  
  enrollments   Enrollment[]
  attendanceRecords AttendanceRecord[]
  submissions   Submission[]
  marks         Mark[]
  skills        StudentSkill[]
  projects      StudentProject[]
  resumes       Resume[]
  placementApplications PlacementApplication[]
}

model Faculty {
  id            String       @id @default(uuid())
  userId        String       @unique
  departmentId  String
  employeeCode  String       @unique
  designation   String       // "Professor", "Associate Professor", "Assistant Professor", "HOD"
  qualification String?
  specialization String?
  cabinNumber   String?
  joiningDate   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  
  courseAssignments CourseAssignment[]
  attendanceSessions AttendanceSession[]
  assignmentsCreated Assignment[]
  marksEntered       Mark[]
}

model Course {
  id            String       @id @default(uuid())
  departmentId  String
  programId     String
  semesterId    String?
  name          String
  code          String       @unique
  credits       Int          @default(3)
  type          String       @default("THEORY") // "THEORY", "LAB", "ELECTIVE"
  description   String?
  syllabusUrl   String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  department    Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  program       Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  semester      Semester?    @relation(fields: [semesterId], references: [id])
  
  assignments   CourseAssignment[]
  enrollments   Enrollment[]
  attendanceSessions AttendanceSession[]
  homeworkAssignments Assignment[]
  marks         Mark[]
}

model CourseAssignment {
  id            String   @id @default(uuid())
  courseId      String
  facultyId     String
  section       String   @default("A")
  isPrimary     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty       Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([courseId, facultyId, section])
}

model Enrollment {
  id            String       @id @default(uuid())
  studentId     String
  courseId      String
  academicYearId String
  semesterId    String
  section       String       @default("A")
  status        String       @default("ENROLLED") // "ENROLLED", "COMPLETED", "DROPPED"
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  student       Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  semester      Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, semesterId])
}

model AttendanceSession {
  id          String   @id @default(uuid())
  courseId    String
  facultyId   String
  section     String   @default("A")
  date        DateTime
  topic       String?
  sessionType String   @default("REGULAR") // "REGULAR", "LAB", "EXTRA"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty     Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  records     AttendanceRecord[]
}

model AttendanceRecord {
  id          String   @id @default(uuid())
  sessionId   String
  studentId   String
  status      String   // "PRESENT", "ABSENT", "EXCUSED"
  remarks     String?
  markedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

model Assignment {
  id          String   @id @default(uuid())
  courseId    String
  facultyId   String
  title       String
  description String
  maxMarks    Float    @default(100)
  dueDate     DateTime
  attachmentUrl String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty     Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id            String    @id @default(uuid())
  assignmentId  String
  studentId     String
  fileUrl       String
  fileName      String
  fileSize      Int       @default(0)
  submittedAt   DateTime  @default(now())
  isLate        Boolean   @default(false)
  obtainedMarks Float?
  feedback      String?
  gradedAt      DateTime?
  status        String    @default("SUBMITTED") // "SUBMITTED", "EVALUATED", "RESUBMITTED"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Exam {
  id            String       @id @default(uuid())
  academicYearId String
  semesterId    String
  name          String       // "Mid-Term Fall 2025", "End-Term Spring 2026"
  type          String       // "INTERNAL", "MID_TERM", "FINAL", "PRACTICAL"
  startDate     DateTime
  endDate       DateTime
  status        String       @default("DRAFT") // "DRAFT", "SUBMITTED", "APPROVED", "PUBLISHED"
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  academicYear  AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  semester      Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  marks         Mark[]
}

model Mark {
  id            String   @id @default(uuid())
  examId        String
  courseId      String
  studentId     String
  facultyId     String?
  internalMarks Float    @default(0)
  externalMarks Float    @default(0)
  practicalMarks Float   @default(0)
  totalMarks    Float    @default(0)
  maxMarks      Float    @default(100)
  grade         String?  // "A+", "A", "B", "C", "F"
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  faculty       Faculty? @relation(fields: [facultyId], references: [id])

  @@unique([examId, courseId, studentId])
}

model Company {
  id          String   @id @default(uuid())
  name        String   @unique
  website     String?
  industry    String?
  description String?
  logoUrl     String?
  contactEmail String?
  contactPhone String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  drives      PlacementDrive[]
}

model PlacementDrive {
  id          String   @id @default(uuid())
  companyId   String
  title       String   // e.g. "Software Development Engineer - 2026 Batch"
  jobRole     String
  jobType     String   @default("FULL_TIME") // "FULL_TIME", "INTERNSHIP", "INTERN_PLUS_FTE"
  packageLpa  Float    // e.g. 14.5 LPA
  location    String
  description String
  deadline    DateTime
  driveDate   DateTime
  status      String   @default("ACTIVE") // "ACTIVE", "IN_PROGRESS", "COMPLETED", "CANCELLED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  eligibilityRules PlacementEligibilityRule[]
  applications PlacementApplication[]
  rounds      PlacementRound[]
}

model PlacementEligibilityRule {
  id              String   @id @default(uuid())
  driveId         String
  minCgpa         Float    @default(6.0)
  maxBacklogs     Int      @default(0)
  allowedBranches String   // JSON string array e.g. '["CSE","IT","ECE"]'
  graduationYear  String   // e.g. "2026"
  requiredSkills  String?  // JSON string array e.g. '["Java","React"]'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  drive           PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
}

model PlacementApplication {
  id          String   @id @default(uuid())
  driveId     String
  studentId   String
  status      String   @default("APPLIED") // "APPLIED", "SHORTLISTED", "INTERVIEW_SCHEDULED", "SELECTED", "REJECTED"
  resumeUrl   String?
  appliedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  drive       PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  results     PlacementResult[]

  @@unique([driveId, studentId])
}

model PlacementRound {
  id          String   @id @default(uuid())
  driveId     String
  roundNumber Int      @default(1)
  name        String   // "Online Assessment", "Technical Interview 1", "HR Round"
  roundDate   DateTime
  venue       String?
  details     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  drive       PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  results     PlacementResult[]
}

model PlacementResult {
  id            String   @id @default(uuid())
  applicationId String
  roundId       String
  status        String   // "CLEARED", "REJECTED", "ABSENT"
  feedback      String?
  clearedAt     DateTime @default(now())

  application   PlacementApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  round         PlacementRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([applicationId, roundId])
}

model StudentSkill {
  id          String   @id @default(uuid())
  studentId   String
  category    String   // "TECHNICAL", "SOFT_SKILL", "TOOL", "LANGUAGE"
  name        String
  proficiency String   @default("INTERMEDIATE") // "BEGINNER", "INTERMEDIATE", "ADVANCED", "EXPERT"
  createdAt   DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, name])
}

model StudentProject {
  id          String   @id @default(uuid())
  studentId   String
  title       String
  description String
  technologies String  // comma-separated or json
  projectUrl  String?
  githubUrl   String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Resume {
  id          String   @id @default(uuid())
  studentId   String
  title       String   @default("Primary Resume")
  fileUrl     String
  fileName    String
  fileSize    Int      @default(0)
  isPrimary   Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Notice {
  id            String       @id @default(uuid())
  institutionId String
  authorId      String
  title         String
  content       String
  category      String       @default("GENERAL") // "ACADEMIC", "EXAM", "PLACEMENT", "EVENT", "ADMINISTRATIVE", "GENERAL"
  priority      String       @default("NORMAL")  // "LOW", "NORMAL", "HIGH", "URGENT"
  targetAudience String      @default("ALL")     // "ALL", "STUDENT", "FACULTY", "DEPT_HEAD"
  departmentId  String?
  courseId      String?
  attachmentUrl String?
  publishedAt   DateTime     @default(now())
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  author        User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reads         NoticeRead[]
}

model NoticeRead {
  id        String   @id @default(uuid())
  noticeId  String
  userId    String
  readAt    DateTime @default(now())

  notice    Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
}

model Event {
  id            String       @id @default(uuid())
  institutionId String
  title         String
  description   String
  category      String       @default("WORKSHOP") // "WORKSHOP", "HACKATHON", "SEMINAR", "CULTURAL", "SPORTS"
  venue         String
  startDate     DateTime
  endDate       DateTime
  capacity      Int          @default(100)
  registeredCount Int        @default(0)
  bannerUrl     String?
  isRegistrationOpen Boolean @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]
}

model EventRegistration {
  id          String   @id @default(uuid())
  eventId     String
  userId      String
  status      String   @default("REGISTERED") // "REGISTERED", "ATTENDED", "CANCELLED"
  registeredAt DateTime @default(now())

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Request {
  id            String   @id @default(uuid())
  userId        String
  type          String   // "LEAVE", "BONAFIDE_CERTIFICATE", "ID_CARD_REISSUE", "ATTENDANCE_CORRECTION", "DOCUMENT_VERIFICATION"
  title         String
  description   String
  reason        String?
  status        String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "CHANGES_REQUESTED"
  adminRemarks  String?
  reviewedById  String?
  reviewedAt    DateTime?
  documentUrl   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // "INFO", "WARNING", "SUCCESS", "DEADLINE", "PLACEMENT"
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id            String       @id @default(uuid())
  institutionId String?
  actorId       String?
  action        String       // e.g. "USER_LOGIN", "ATTENDANCE_MARKED", "RESULT_PUBLISHED", "STUDENT_CREATED"
  entityType    String       // "User", "AttendanceSession", "Exam", "PlacementDrive"
  entityId      String?
  details       String?      // JSON string of changes
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime     @default(now())

  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  actor         User?        @relation(fields: [actorId], references: [id])
}

model FileMetadata {
  id          String   @id @default(uuid())
  originalName String
  storageKey  String
  mimeType    String
  size        Int
  uploadedBy  String
  entityType  String   // "RESUME", "ASSIGNMENT", "SUBMISSION", "EVENT_BANNER", "NOTICE_ATTACHMENT"
  entityId    String?
  createdAt   DateTime @default(now())
}
